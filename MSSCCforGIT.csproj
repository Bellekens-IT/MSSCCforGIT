<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- Compiles directly to native machine code without requiring a .NET runtime installation.
			 Scoped to actual publish only (not regular/design-time builds) - setting PublishAot and
			 RuntimeIdentifier unconditionally at the project level makes every build, including the
			 WinForms designer's own design-time build, look like an AOT/RID-specific publish, which
			 breaks the "design tools server" process used by the Form designer (double-click a
			 .cs/.Designer.cs file to open it visually fails with "Failed to launch the design tools
			 server process"). -->
		<PublishAot Condition="'$(_IsPublishing)' == 'true'">true</PublishAot>
		<!-- Defaults to win-x86 (EA is normally 32-bit), but can be overridden, e.g.
			 `-p:PublishRuntimeIdentifier=win-x64`, to publish for 64-bit EA instead. -->
		<PublishRuntimeIdentifier Condition="'$(PublishRuntimeIdentifier)' == ''">win-x86</PublishRuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(_IsPublishing)' == 'true'">$(PublishRuntimeIdentifier)</RuntimeIdentifier>
		<!-- Enables WinForms dialogs (SccHistory/SccProperties) for a nicer UI than MessageBoxW. -->
		<UseWindowsForms>true</UseWindowsForms>
		<!--
		  WinForms itself (System.Windows.Forms/.Primitives, System.Private.Windows.Core,
		  System.Formats.Nrbf) isn't fully AOT-clean and emits IL3053 (AOT analysis warnings in
		  those framework assemblies) and IL3000 (Assembly.Location under single-file/AOT) purely
		  from framework code we don't control - not from our own SccHistory/SccProperties dialog
		  code, which only uses basic controls (Form/Label/ListView/Button/TableLayoutPanel).
		-->
		<NoWarn>$(NoWarn);IL3053;IL3000</NoWarn>
	</PropertyGroup>
	<ItemGroup>
	  <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="MSSCCforGIT.IntegrationTests\**" />
	  <EmbeddedResource Remove="MSSCCforGIT.IntegrationTests\**" />
	  <None Remove="MSSCCforGIT.IntegrationTests\**" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="MSSCCforGIT.Setup\MSSCCforGIT.Setup.wixproj" />
	</ItemGroup>

	<!--
	  Automatically produce the native AOT DLL after a Release build so the output used by
	  EA (bin\Release\net10.0\win-x86\publish\MSSCCforGIT.dll) is always up to date.
	  Runs `dotnet publish` as an external process to avoid recursive MSBuild invocation.
	  Publishes for both win-x86 (32-bit EA, the common case) and win-x64 (64-bit EA) so both
	  installer variants have fresh output to package.
	-->
	<Target Name="PublishNativeAot" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' AND '$(_IsPublishing)' != 'true'">
		<Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c $(Configuration) -r win-x86 --self-contained -p:_IsPublishing=true -p:PublishRuntimeIdentifier=win-x86" />
		<Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c $(Configuration) -r win-x64 --self-contained -p:_IsPublishing=true -p:PublishRuntimeIdentifier=win-x64" />
	</Target>
</Project>
